digraph fig5 {
  rankdir=TB;
  graph [fontname="Helvetica", fontsize=10, bgcolor="white", margin="0.1"];
  node [shape=box, style="rounded", fontname="Helvetica", fontsize=9, color="#222222"];
  edge [fontname="Helvetica", fontsize=8, color="#222222", arrowsize=0.7];
  Q [label="Reconstruction request"];
  R [label="Resolve Decision ID"];
  S [label="Retrieve sealed objects"];
  V [label="Version and temporal validity checks"];
  T [label="Mandatory bindings present?", shape=diamond, width=2.2, height=1.0];
  U [label="Unavailable / Failed"];
  Tri [label="Reconstruct triad:\njustification, authorization,\ntemporal validity"];
  Out [label="Coverage", shape=diamond, width=1.6, height=0.9];
  C [label="Complete"];
  P [label="Partial"];
  F [label="Failed justification\n(e.g., reliance deleted)"];
  Q -> R -> S -> V -> T;
  T -> U [xlabel="no"];
  T -> Tri [xlabel="yes"];
  Tri -> Out;
  Out -> C [xlabel="all required"];
  Out -> P [xlabel="some retained"];
  Out -> F [xlabel="reliance gone"];
}
