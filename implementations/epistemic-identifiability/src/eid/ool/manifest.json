{
 "version": "ool-1",
 "note": "Frozen benchmark specification (written before any agent code in eid/ool existed). Dynamics: x1' = -B1 x1 + G u1 (observed, noisy); x2' = -a x2 + c*phi + e*u2 (hidden); x3' = -b3 x3 + d x2 (observed, noisy); x4 nuisance. phi is the mechanism expression below. Variables: x = x1; xd = x1'; z = leaky integral of x1 (tau); xdel = x1(t - k samples); x2 = hidden state. Functions: sin, exp, tanh, sqrt, abs, sign, floor, relu(v)=max(v,0), step(v)=1[v>0].",
 "families": {
  "lin":     {"split": ["calib", "dev"], "expr": "x", "params": {}, "klass": "control", "identifiable": true, "sig": [["id(id)"]]},
  "sat":     {"split": ["calib"], "expr": "p*tanh(x/p)", "params": {"p": [0.25, 0.8]}, "klass": "known", "identifiable": true, "sig": [["tanh(id)"]]},
  "quad":    {"split": ["calib"], "expr": "x*x", "params": {}, "klass": "known", "identifiable": true, "sig": [["sq(id)"]]},
  "gate":    {"split": ["calib"], "expr": "x*step(x-p)", "params": {"p": [0.2, 0.7]}, "klass": "known", "identifiable": true, "sig": [["gate(id)"]]},
  "delay":   {"split": ["calib"], "expr": "xdel", "params": {}, "delay": [3, 9], "klass": "known", "identifiable": true, "sig": [["id(delay)"]]},
  "sin":     {"split": ["dev"], "expr": "sin(q*x)", "params": {"q": [3.0, 4.5]}, "klass": "A_operator", "identifiable": true, "sig": [["sin(id)"]]},
  "rectsq":  {"split": ["dev"], "expr": "relu(x*x-p)", "params": {"p": [0.1, 0.3]}, "klass": "C_composition", "identifiable": true, "sig": [["relu(sq)"]]},
  "leak":    {"split": ["dev"], "expr": "z", "params": {}, "tau": [1.5, 3.5], "klass": "B_state", "identifiable": true, "sig": [["id(lp)"]]},
  "bilin":   {"split": ["dev"], "expr": "x*(1+g*x2)", "params": {"g": [0.2, 0.4]}, "klass": "C_composition", "identifiable": true, "sig": [["id(id)", "XINT"]]},
  "thresh":  {"split": ["dev"], "expr": "x*step(x-p)", "params": {"p": [1.1, 1.5]}, "klass": "N_nonidentifiable", "identifiable": false, "sig": [[]]},
  "bump":    {"split": ["holdout"], "expr": "x*exp(-(x/p)**2)", "params": {"p": [0.3, 0.5]}, "klass": "A_operator", "identifiable": true, "sig": [["bump(id)"]]},
  "sqrtabs": {"split": ["holdout"], "expr": "sign(x)*sqrt(abs(x))", "params": {}, "klass": "A_operator", "identifiable": true, "sig": [["sqrtabs(id)"]]},
  "rate":    {"split": ["holdout"], "expr": "r*xd", "params": {"r": [0.2, 0.4]}, "klass": "B_state", "identifiable": true, "sig": [["id(rate)"]]},
  "gdelay":  {"split": ["holdout"], "expr": "xdel*step(xdel-p)", "params": {"p": [0.2, 0.5]}, "delay": [3, 8], "klass": "C_composition", "identifiable": true, "sig": [["gate(delay)"]]},
  "quadlag": {"split": ["holdout"], "expr": "z*z", "params": {}, "tau": [1.5, 3.5], "klass": "C_composition", "identifiable": true, "sig": [["sq(lp)"]]},
  "bumpfar": {"split": ["holdout"], "expr": "exp(-((x-1.3)/0.1)**2)", "params": {}, "klass": "N_nonidentifiable", "identifiable": false, "sig": [[]]},
  "saw":     {"split": ["holdout"], "expr": "(q*x-floor(q*x))-0.5", "params": {"q": [2.0, 3.0]}, "klass": "X_beyond_closure", "identifiable": true, "sig": []}
 }
}
