# Normalize text; keep Markdown and YAML as first-class sources.
* text=auto eol=lf

*.md   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.bib  text eol=lf
*.mmd  text eol=lf
*.puml text eol=lf
*.svg  text eol=lf

*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary
*.zip  binary
